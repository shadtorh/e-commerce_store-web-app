# AWS Configuration for Ritualist
VITE_AWS_REGION=us-east-1
VITE_AWS_ACCESS_KEY_ID=your_access_key_id
VITE_AWS_SECRET_ACCESS_KEY=your_secret_access_key

# AWS Cognito
VITE_COGNITO_CLIENT_ID=your_cognito_client_id
VITE_COGNITO_USER_POOL_ID=your_user_pool_id

# AWS SNS
VITE_SNS_PLATFORM_ARN=arn:aws:sns:us-east-1:123456789012:app/GCM/Ritualist

# AWS Lambda
VITE_LAMBDA_FUNCTION_ARN=arn:aws:lambda:us-east-1:123456789012:function:send-routine-reminder
